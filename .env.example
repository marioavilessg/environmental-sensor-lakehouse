# Local Docker environment template.
# Copy this file to `.env` before starting Docker Compose.

# Hadoop memory options used by the Hadoop containers.
HADOOP_OPTS="-Xmx512m -Xms512m"

# MinIO defaults used by the IoT pipeline inside Docker/Jupyter.
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="adminadmin"

# Optional HTTP receiver settings.
IOT_RECEIVER_HOST="0.0.0.0"
IOT_RECEIVER_PORT="5050"
